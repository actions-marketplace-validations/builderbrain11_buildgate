# Local development defaults bind only to loopback (127.0.0.1).
PORT=3050
HOST=127.0.0.1

# Required (minimum 32 characters) when HOST is not loopback.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUILDGATE_API_TOKEN=

# Comma-separated exact origins allowed to call the API from a browser.
BUILDGATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional override for the reference fixture path.
# BUILDGATE_FIXTURE_PATH=

# Optional: set to 'true' during local offline development without Docker.
# In production, leave unset to enforce strict Docker container isolation.
BUILDGATE_ALLOW_HOST_FALLBACK=false

# Required to accept GitHub webhooks. No insecure default is provided.
GITHUB_WEBHOOK_SECRET=
